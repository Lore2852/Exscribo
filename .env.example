# Copia questo file in ".env" (cp .env.example .env) e modifica i valori lì.
# Il file .env è escluso da Git; questo .env.example invece è pubblico
# e serve solo da modello: non scriverci mai valori segreti.

# Indirizzo di Ollama sul tuo Mac (di solito non va cambiato).
OLLAMA_URL=http://localhost:11434

# Modello che scrive le risposte.
# - Mac con 8 GB di RAM:  qwen2.5:3b
# - Mac con 16 GB o più:  qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b
