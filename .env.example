# Copia questo file in ".env" (cp .env.example .env) e modifica i valori lì.
# Il file .env è escluso da Git; questo .env.example invece è pubblico
# e serve solo da modello: non scriverci mai valori segreti.

# Indirizzo di Ollama sul tuo Mac (di solito non va cambiato).
OLLAMA_URL=http://localhost:11434

# Modello che scrive le risposte.
# - Mac con 8 GB di RAM:  qwen2.5:3b
# - Mac con 16 GB o più:  qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b

# Modello che trasforma i testi in vettori (embedding) per trovare i brani giusti.
# bge-m3 è multilingue, quindi capisce bene l'italiano.
OLLAMA_EMBED_MODEL=bge-m3

# Punteggio minimo (da 0 a 1) del brano più pertinente. Se nessun brano lo
# raggiunge, la domanda è considerata fuori tema e l'app risponde
# "Non l'ho trovato nei tuoi appunti" senza interpellare il modello.
# Più è alta, più l'app è prudente (ma rischia di scartare domande valide).
SOGLIA_PERTINENZA=0.5
